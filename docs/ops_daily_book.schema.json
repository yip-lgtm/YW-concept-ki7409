{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yip-lgtm/YW-concept-ki7409/docs/ops_daily_book.schema.json",
  "title": "YW Ops Daily Book (Tradovate sim PAAPEX…091)",
  "description": "Drop equity/fills from Ops without changing strategy code. Consumed by automation/scripts/daily_settlement_llm_opt.py.",
  "type": "object",
  "required": ["date"],
  "additionalProperties": true,
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "HKT settlement date YYYY-MM-DD"
    },
    "account": {
      "type": "string",
      "description": "Book id, e.g. PAAPEX…091",
      "default": "PAAPEX…091"
    },
    "equity_start": { "type": ["number", "null"], "description": "Day-start equity (USD)" },
    "equity_end": { "type": ["number", "null"], "description": "Settlement equity (USD)" },
    "session_high_equity": {
      "type": ["number", "null"],
      "description": "Optional session peak equity; DD may be measured vs this instead of day-start"
    },
    "day_pnl": {
      "type": ["number", "null"],
      "description": "Optional explicit day P/L; else equity_end - equity_start"
    },
    "open_pl": { "type": ["number", "null"], "description": "Open / unrealized P/L" },
    "working_count": { "type": ["integer", "null"], "description": "Working orders count" },
    "fills": {
      "type": "array",
      "description": "Ops fills for the HKT day (sim book)",
      "items": {
        "type": "object",
        "properties": {
          "strategy": { "type": "string" },
          "ticker": { "type": "string" },
          "side": { "type": "string" },
          "qty": { "type": "number", "default": 1 },
          "pnl_usd": { "type": "number" },
          "exit_level": { "type": "string" },
          "paper_sl": { "type": ["number", "null"] },
          "fill_sl": { "type": ["number", "null"] },
          "paper_t1": { "type": ["number", "null"] },
          "fill_t1": { "type": ["number", "null"] },
          "note": { "type": "string" }
        }
      }
    },
    "last_handoff": {
      "type": "string",
      "description": "Last Ops handoff text (should say QTY=1 Bracket, not Group QTY20)"
    },
    "false_out_of_gate": {
      "type": "string",
      "description": "e.g. MBT 83660 Order Ticket Limit used as sim last"
    },
    "ops_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "qty_policy": {
      "type": "string",
      "const": "QTY=1 Bracket",
      "description": "Live policy reminder"
    }
  }
}
